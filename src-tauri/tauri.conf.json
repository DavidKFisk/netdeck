{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetDeck",
  "version": "1.26.9",
  "identifier": "com.netdeck.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NetDeck",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NetDeck",
    "shortDescription": "Network & system command reference",
    "longDescription": "Searchable reference of network and system commands with live execution, structured output and guided troubleshooting playbooks.",
    "category": "Utility",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "NetDeck",
        "displayLanguageSelector": false
      }
    }
  }
}
